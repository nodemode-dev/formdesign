      {"kind": "text", "slot": "stat1", "rect": [420, 141.39, 144, 74], "style": "Box Stat", "sample": "1 in 4"},
      {"kind": "text", "slot": "stat1.label", "rect": [420, 219.94, 144, 37], "style": "Box Stat Label", "sample": "commuters in the region now cycle at least once a week, up from one in ten five years ago."},
      {"kind": "text", "rect": [408, 316.73, 168, 15], "style": "Item Num", "text": "02 · Science"},
      {"kind": "text", "slot": "feature2.title", "rect": [408, 329.89, 168, 42], "style": "Item Head", "sample": "Bees prefer the night shift"},
      {"kind": "text", "slot": "feature2.body", "rect": [408, 373.05, 168, 107], "style": "Item Body", "sample": "A three-year study of urban rooftops found that some solitary bees forage well after dusk, guided by street lighting. Researchers now want cities to dim lamps in parks during summer and to plant more late-flowering shrubs. Early trials suggest the change costs little and saves energy."},
      {"kind": "line", "from": [36, 550], "to": [576, 550], "stroke": {"color": "ink", "weight": 0.75}},
      {"kind": "text", "rect": [36, 560.73, 168, 15], "style": "Item Num", "text": "03 · Food"},
      {"kind": "text", "slot": "feature3.title", "rect": [36, 573.89, 168, 25], "style": "Item Head", "sample": "Grain is the new coffee"},
      {"kind": "text", "slot": "feature3.body", "rect": [36, 600.51, 168, 98], "style": "Item Body", "sample": ["Small mills are selling single-farm flours with tasting notes on the bag. One baker in the north lists the field, the variety and the week of harvest beside every loaf.", "Prices are higher, but so is the queue on Saturday mornings."]},
      {"kind": "line", "from": [213, 564], "to": [213, 746], "stroke": {"color": "muted", "weight": 0.5}},
      {"kind": "image", "slot": "image2", "rect": [222, 564, 168, 96]},
      {"kind": "text", "rect": [222, 668.73, 168, 15], "style": "Item Num", "text": "04 · Design"},
      {"kind": "text", "slot": "feature4.title", "rect": [222, 681.89, 168, 25], "style": "Item Head", "sample": "A chair for libraries"},
      {"kind": "text", "slot": "feature4.body", "rect": [222, 708.51, 168, 27], "style": "Item Body", "sample": "Stackable, repairable and made from old shelving boards."},
      {"kind": "line", "from": [399, 564], "to": [399, 746], "stroke": {"color": "muted", "weight": 0.5}},
