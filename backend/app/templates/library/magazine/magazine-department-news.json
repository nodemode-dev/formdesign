      {"kind": "text", "rect": [36, 362.73, 354, 15], "style": "Item Num", "text": "01 · Cities"},
      {"kind": "text", "slot": "feature1.title", "rect": [36, 372.79, 354, 62], "style": "Item Head Large", "sample": "The city that pays you to plant a tree"},
      {"kind": "text", "slot": "feature1.body", "rect": [36, 433.4, 354, 86], "style": "Item Body", "sample": ["Residents who plant and water a street tree for two summers now get a rebate on their water bill. The scheme started as a pilot on six streets and has since spread to every district in the city.", "Officials say the canopy has grown by a fifth, and so has the number of people who know their neighbours by name. The rebate is small; the shade, it turns out, is the point.", "The council plans to double the number of streets in the scheme next year."], "columns": 2, "gutter": 18},
      {"kind": "line", "from": [399, 124], "to": [399, 536], "stroke": {"color": "muted", "weight": 0.5}},
      {"kind": "rect", "rect": [408, 124, 168, 180], "fill": "accent"},
