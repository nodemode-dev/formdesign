      {"kind": "text", "slot": "stat1.label", "rect": [344, 287.64, 211.28, 20], "style": "Verdict", "sample": ["Verdict: essential", "Reviewed by June Alder"]},
      {"kind": "text", "slot": "item1.body", "rect": [280, 343.51, 275.28, 57], "style": "Rev Body", "sample": "Mira Castell's third novel follows a woman who inherits a failing orchard and a box of her father's unsent letters. Quiet, funny and sharp about money, it ends with one long night of frost that is the best thing she has written."},
      {"kind": "line", "from": [40, 424], "to": [555.28, 424], "stroke": {"color": "ink", "weight": 0.75}},
      {"kind": "text", "slot": "item2.price", "rect": [40, 439.65, 187.64, 9], "style": "Rev Details", "sample": "Album · Fernlight Records · 41 min"},
      {"kind": "text", "slot": "item2.title", "rect": [40, 451.2, 187.64, 28], "style": "Rev Title", "sample": "Low Tide Choir"},
      {"kind": "text", "slot": "stat2", "rect": [239.64, 438, 44, 44], "style": "Score", "shape": "ellipse", "fill": "accent", "valign": "center", "sample": "3/5"},
      {"kind": "text", "slot": "item2.body", "rect": [40, 491.51, 243.64, 42], "style": "Rev Body", "sample": "A gorgeous, slightly sleepy record of folk songs arranged for nine voices and a harmonium. Best heard late, with the lights off and the window open."},
      {"kind": "text", "slot": "item3.price", "rect": [311.64, 439.65, 187.64, 9], "style": "Rev Details", "sample": "Film · dir. Oriel Mbeki · 104 min"},
      {"kind": "text", "slot": "item3.title", "rect": [311.64, 451.2, 187.64, 28], "style": "Rev Title", "sample": "The Long Ferry"},
      {"kind": "text", "slot": "stat3", "rect": [511.28, 438, 44, 44], "style": "Score", "shape": "ellipse", "fill": "accent2", "valign": "center", "sample": "5/5"},
      {"kind": "text", "slot": "item3.body", "rect": [311.64, 491.51, 243.64, 42], "style": "Rev Body", "sample": "A night crossing, six strangers and a storm that never quite arrives. Mbeki turns a simple premise into the tensest and kindest film of the year."},
      {"kind": "line", "from": [40, 544], "to": [555.28, 544], "stroke": {"color": "ink", "weight": 0.75}},
      {"kind": "text", "slot": "item4.price", "rect": [40, 558.65, 187.64, 9], "style": "Rev Details", "sample": "Exhibition · Harbour Gallery"},
      {"kind": "text", "slot": "item4.title", "rect": [40, 570.2, 187.64, 28], "style": "Rev Title", "sample": "Paper Weather"},
      {"kind": "text", "slot": "stat4", "rect": [239.64, 557, 44, 44], "style": "Score", "shape": "ellipse", "fill": "accent", "valign": "center", "sample": "4/5"},
      {"kind": "text", "slot": "item4.body", "rect": [40, 610.51, 243.64, 57], "style": "Rev Body", "sample": "Two hundred kites from four continents, hung so they seem to drift through the rooms. Open until 2 February; go on a weekday morning and you may have the whole sky to yourself."},
      {"kind": "text", "slot": "item5.price", "rect": [311.64, 558.65, 187.64, 9], "style": "Rev Details", "sample": "Theatre · The Lamp Room · 90 min"},
      {"kind": "text", "slot": "item5.title", "rect": [311.64, 570.2, 187.64, 28], "style": "Rev Title", "sample": "A House of Clocks"},
      {"kind": "text", "slot": "stat5", "rect": [511.28, 557, 44, 44], "style": "Score", "shape": "ellipse", "fill": "accent2", "valign": "center", "sample": "2/5"},
      {"kind": "text", "slot": "item5.body", "rect": [311.64, 610.51, 243.64, 42], "style": "Rev Body", "sample": "Handsome staging and a fine lead, but the script cannot decide whether it is a ghost story or a comedy, and the second half drags."},
