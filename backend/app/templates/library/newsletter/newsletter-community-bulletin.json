      {"kind": "text", "slot": "feature8.title", "rect": [184, 931.71, 202, 50], "style": "Box Head", "sample": "Meet Odile Brennan, keeper of the bees"},
      {"kind": "text", "slot": "feature8.body", "rect": [184, 981.79, 202, 154.21], "style": "Box Body", "sample": ["Odile has kept hives behind the allotments for twenty-two years. This summer her bees made a record ninety jars of honey, and every one went to the school fair.", "She is looking for an apprentice. No experience needed, just a calm temperament and a free Sunday morning."]},
