      {"kind": "text", "slot": "brand", "rect": [40, 92.53, 511.28, 95], "style": "Mast", "sample": "The Current"},
      {"kind": "rect", "rect": [0, 210, 604.28, 5], "fill": "accent"},
      {"kind": "image", "slot": "hero", "rect": [44, 232, 511.28, 230]},
      {"kind": "text", "slot": "caption", "rect": [44, 468.15, 511.28, 11], "style": "Caption", "sample": "An otter's tracks in the mud below Hatch Bridge, photographed by volunteer Ruth Okeke."},
      {"kind": "text", "slot": "kicker", "rect": [44, 498.1, 330, 11], "style": "Section Label", "sample": "Restoration"},
      {"kind": "text", "slot": "title", "rect": [44, 510.64, 330, 67], "style": "Lead Title", "sample": "Otters return to the upper Ashwell"},
      {"kind": "text", "slot": "subtitle", "rect": [44, 579.76, 330, 32], "style": "Lead Deck", "sample": "After nine years of bank planting and patient volunteering, the river is giving something back."},
      {"kind": "text", "flow": "body", "rect": [44, 624, 330, 161.89], "style": "NP Body", "columns": 2, "gutter": 16, "sample": ["The first sign was a spraint on a stone below Hatch Bridge. Then came the tracks, and finally, in August, a trail camera caught a mother and two cubs crossing the shallows at dusk.", "Otters disappeared from the upper river in the 1970s. Their return means the water is clean enough, the fish plentiful enough and the banks wild enough to raise a family.", "None of that happened by accident. Since 2017 our volunteers have planted eleven thousand trees, removed four old weirs and fenced two miles of bank to keep cattle out of the water.", "The otters will need more help. The stretch below Ashwell town is still hemmed in by walls and culverts, and our next project will open a green corridor along it."]},
      {"kind": "rect", "rect": [390, 492, 165.28, 135], "fill": "tint"},
      {"kind": "text", "rect": [404, 506.1, 137.28, 11], "style": "Section Label", "text": "In this issue"},
      {"kind": "text", "slot": "list", "rect": [404, 527.62, 137.28, 86], "style": "Index", "sample": ["• A letter from our director", "• The year in numbers", "• Volunteer spotlight", "• News in brief", "• Events and how to help"]},
      {"kind": "line", "from": [390, 701.26], "to": [430, 701.26], "stroke": {"color": "accent", "weight": 3}},
      {"kind": "text", "slot": "stat1", "rect": [390, 711.42, 165.28, 40], "style": "Stat Big", "sample": "1,240"},
      {"kind": "text", "slot": "stat1.label", "rect": [390, 748.95, 165.28, 25], "style": "Stat Text", "sample": "members and friends now support the Trust. Thank you."}
    ]},
    {"parent": "A", "items": [
      {"kind": "text", "slot": "section", "rect": [40, 48.1, 300, 11], "style": "Section Label", "sample": "From the director"},
      {"kind": "text", "slot": "feature1.title", "rect": [40, 62.06, 511.28, 30], "style": "Sec Title", "sample": "A good year to be a river"},
      {"kind": "image", "slot": "portrait", "rect": [40, 107, 140, 176]},
      {"kind": "text", "slot": "feature1.body", "rect": [198, 104.44, 353.28, 153], "style": "Letter", "sample": ["Dear friends, when I wrote to you last autumn the river was low, the summer had been hard and we were worried about the fish. What a difference a year makes.", "Thanks to you, we planted more trees this winter than in any year since the Trust began. We opened the new classroom at Hatch Mill, and more than nine hundred children have already pulled on waders there. And now, the otters.", "None of this would be possible without the people who give their Saturdays, their skills and their money. I hope you will stay with us for the next chapter."]},
      {"kind": "text", "slot": "name", "rect": [198, 264.44, 353.28, 19], "style": "Sign", "sample": "Maren Holt"},
      {"kind": "text", "slot": "role", "rect": [198, 287.86, 353.28, 12], "style": "Sign Role", "sample": "Director, Ashwell River Trust"},
