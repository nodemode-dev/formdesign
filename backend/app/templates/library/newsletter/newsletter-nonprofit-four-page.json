      {"kind": "line", "from": [40, 530], "to": [80, 530], "stroke": {"color": "accent", "weight": 3}},
      {"kind": "text", "slot": "quote", "rect": [40, 545.25, 243.64, 114], "style": "Quote Big", "sample": "I came for the tree planting and stayed for the people. Saturday mornings on the river are the best part of my week."},
