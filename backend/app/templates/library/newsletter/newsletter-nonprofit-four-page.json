      {"kind": "text", "rect": [298, 48.1, 257.28, 11], "style": "Section Label", "text": "Volunteer spotlight"},
      {"kind": "text", "slot": "feature2.title", "rect": [298, 62.06, 257.28, 55], "style": "Sec Title", "sample": "Twenty Saturdays with the bank crew"},
      {"kind": "text", "slot": "feature2.body", "rect": [298, 123.19, 257.28, 220.81], "style": "NP Body", "sample": ["Ruth Okeke joined the bank crew on a wet Saturday in 2022 and has missed only three sessions since. A retired nurse, she now leads the Thursday group and keeps the trail cameras running.", "It was Ruth who found the first otter tracks. She says she nearly walked past them, and that she will be looking at the mud more carefully from now on.", "When she is not on the river she is teaching her grandchildren to tell a dipper from a wagtail. Both of them, she reports, are now better at it than she is."]},
      {"kind": "line", "from": [44, 374], "to": [555.28, 374], "stroke": {"color": "ink", "weight": 1}},
      {"kind": "text", "rect": [44, 388.1, 300, 11], "style": "Section Label", "text": "News in brief"},
      {"kind": "text", "slot": "feature3.title", "rect": [44, 410.68, 159.76, 18], "style": "Brief Title", "sample": "New classroom opens"},
      {"kind": "text", "slot": "feature3.body", "rect": [44, 430.94, 159.76, 56], "style": "NP Body", "sample": "The river classroom at Hatch Mill welcomed its first school group in May. Bookings for next year are open now."},
      {"kind": "text", "slot": "feature4.title", "rect": [219.76, 410.68, 159.76, 18], "style": "Brief Title", "sample": "Weir comes down"},
      {"kind": "text", "slot": "feature4.body", "rect": [219.76, 430.94, 159.76, 56], "style": "NP Body", "sample": "The last weir on the Lyne was removed in July, opening nine kilometres of gravel to spawning trout."},
      {"kind": "text", "slot": "feature5.title", "rect": [395.52, 410.68, 159.76, 18], "style": "Brief Title", "sample": "Thank you, Hartfield"},
      {"kind": "text", "slot": "feature5.body", "rect": [395.52, 430.94, 159.76, 42], "style": "NP Body", "sample": "Hartfield Primary raised enough with a sponsored paddle to plant two hundred trees along Mill Meadow."},
