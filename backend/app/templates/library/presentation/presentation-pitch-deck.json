      {"kind": "text", "slot": "stat1.label", "rect": [1200, 316, 540, 110], "style": "Stat Text", "sample": "single-use containers thrown away by UK delivery orders every year"},
      {"kind": "line", "from": [1200, 500], "to": [1740, 500], "stroke": {"color": "ink", "weight": 2}},
      {"kind": "text", "slot": "stat2", "rect": [1200, 560, 560, 140], "style": "Big Stat", "sample": "83%"},
      {"kind": "text", "slot": "stat2.label", "rect": [1200, 706, 540, 110], "style": "Stat Text", "sample": "of regular diners say the packaging waste puts them off ordering"}
    ]},
