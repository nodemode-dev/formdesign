      {"kind": "text", "slot": "item1.title", "rect": [170, 630, 440, 50], "style": "Step Title", "sample": "Order as usual"},
      {"kind": "text", "slot": "item1.body", "rect": [170, 690, 440, 160], "style": "Step Body", "sample": "Choose Vessly at checkout in any partner app. Your meal arrives in sturdy, leak-proof containers."},
