      {"kind": "text", "slot": "feature2.meta", "rect": [226, 448, 329.28, 16], "style": "CV Meta", "sample": "Westbrook Evening Post · 2017 to 2021"},
      {"kind": "text", "slot": "feature2.body", "rect": [226, 468, 329.28, 60], "style": "CV Body", "sample": "Wrote and charted weekly data stories, trained the newsroom in spreadsheets and filed more than two hundred information requests that fed front-page splashes."},
      {"kind": "text", "slot": "feature3.title", "rect": [226, 538, 329.28, 22], "style": "CV Job", "sample": "Reporter"},
      {"kind": "text", "slot": "feature3.meta", "rect": [226, 560, 329.28, 16], "style": "CV Meta", "sample": "Valley Gazette · 2014 to 2017"},
      {"kind": "text", "slot": "feature3.body", "rect": [226, 580, 329.28, 60], "style": "CV Body", "sample": "Covered councils, courts and schools across three districts, and launched the paper's first interactive election results page, read by a third of local voters."},
