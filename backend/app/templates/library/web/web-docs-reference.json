    "Side Foot": {"basedOn": "Small", "size": 0.72},
    "Doc Kicker": {"basedOn": "Kicker", "size": 0.72, "tracking": 100},
    "Doc Title": {"basedOn": "Title", "size": 2.6, "leading": 1.1, "tracking": -20, "spaceAfter": 0},
    "Lede": {"basedOn": "Subtitle", "size": 1.1, "leading": 1.5},
    "Callout": {"font": "text", "size": 0.85, "leading": 1.45, "color": "ink", "hyphenate": false},
