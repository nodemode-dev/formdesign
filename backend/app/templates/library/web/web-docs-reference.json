      {"kind": "text", "slot": "nav", "rect": [32, 140, 236, 340], "style": "Side Nav", "sample": ["Introduction", "Quickstart", "Authentication", "Errors", "Rate limits", "Pagination", "Webhooks", "Idempotency", "Versioning", "SDKs and libraries"]},
      {"kind": "text", "slot": "footer", "rect": [32, 1420, 236, 20], "style": "Side Foot", "sample": "© 2026 Corvane Labs · Status · Terms"},
      {"kind": "text", "slot": "kicker", "rect": [360, 110, 680, 20], "style": "Doc Kicker", "sample": "Getting started · Authentication"},
      {"kind": "text", "slot": "title", "rect": [360, 138, 680, 76], "style": "Doc Title", "sample": "Authentication"},
      {"kind": "text", "slot": "subtitle", "rect": [360, 222, 680, 96], "style": "Lede", "sample": "Every request to the Corvane API is signed with a secret key. This page shows how to create a key, send it with a request and keep it safe."},
      {"kind": "rect", "rect": [360, 340, 680, 62], "fill": "tint", "corner": 6},
      {"kind": "rect", "rect": [360, 340, 4, 62], "fill": "accent"},
      {"kind": "text", "slot": "note", "rect": [384, 340, 636, 62], "style": "Callout", "valign": "center", "sample": "This page covers version 3 of the API. Moving from version 2? Read the migration guide first."},
      {"kind": "text", "flow": "body", "rect": [360, 438, 680, 46], "style": "Heading 2", "sample": ["Create an API key"]},
      {"kind": "text", "flow": "body", "rect": [360, 484, 680, 112], "style": "Body", "sample": ["Keys are created in the dashboard under Settings, then API keys. Each key belongs to one project and can be limited to read-only or full access. Copy the secret as soon as it appears: for your safety it is shown only once."]},
      {"kind": "text", "flow": "body", "rect": [360, 604, 680, 44], "style": "Code", "sample": ["export CORVANE_KEY=cv_test_9f2a71c4e8b0d3"]},
      {"kind": "text", "flow": "body", "rect": [360, 666, 680, 46], "style": "Heading 2", "sample": ["Send your first request"]},
      {"kind": "text", "flow": "body", "rect": [360, 712, 680, 84], "style": "Body", "sample": ["Pass the key in the Authorization header as a bearer token. A request without a valid key returns a 401 error with the code missing_key or invalid_key."]},
      {"kind": "text", "flow": "body", "rect": [360, 806, 680, 96], "style": "Code", "sample": ["curl https://api.corvane.dev/v3/projects \\", "  -H \"Authorization: Bearer $CORVANE_KEY\" \\", "  -H \"Accept: application/json\""]},
      {"kind": "text", "flow": "body", "rect": [360, 918, 680, 46], "style": "Heading 2", "sample": ["Keep your keys safe"]},
      {"kind": "text", "flow": "body", "rect": [360, 964, 680, 190], "style": "List", "sample": ["Store keys in environment variables or a secrets manager, never in source code.", "Use test keys while you build. They work against sample data and cannot move real money.", "Rotate a key straight away if you think it has leaked. Revoked keys stop working within a minute."]},
      {"kind": "text", "flow": "body", "rect": [360, 1160, 680, 46], "style": "Heading 2", "sample": ["Rotate a key"]},
      {"kind": "text", "flow": "body", "rect": [360, 1206, 680, 84], "style": "Body", "sample": ["Create the new key first, deploy it everywhere it is used, then revoke the old one from the dashboard or with a single request:"]},
      {"kind": "text", "flow": "body", "rect": [360, 1300, 680, 140], "style": "Code", "sample": ["curl -X DELETE https://api.corvane.dev/v3/keys/key_7Hq2 \\", "  -H \"Authorization: Bearer $CORVANE_KEY\""]},
      {"kind": "text", "rect": [1120, 110, 240, 20], "style": "Side Label", "text": "On this page"},
      {"kind": "line", "from": [1110, 142], "to": [1110, 270], "stroke": {"color": "tint", "weight": 2}},
