#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
[ -f venv/bin/activate ] || { echo "[formdes] engine venv missing, run ./formdes install" >&2; exit 1; }
# shellcheck disable=SC1091
source venv/bin/activate
exec uvicorn app.main:app --reload --reload-dir app --host "${FORMDES_HOST:-127.0.0.1}" --port "${FORMDES_PORT:-8196}"
