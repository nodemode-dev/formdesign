#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
cd "$FORMDESIGN_ROOT/native"
exe="$(fd_exe)"
if command -v cargo >/dev/null 2>&1; then
  fd_say "building formdesign-core (the first build compiles the layout engine: a few minutes)"
  cargo build --release -p formdesign-core
  fd_say "layout core ready: native/target/release/formdesign-core$exe"
  exit 0
fi
fd_die "the layout core is built from source and cargo was not found: install Rust from https://rustup.rs and rerun ./formdesign install-core (FormDesign does not download a prebuilt core)"
