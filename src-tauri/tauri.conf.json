{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormDesign",
  "version": "0.85.6",
  "identifier": "ai.nodemode.formdesign",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FormDesign",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Page layout and publishing",
    "longDescription": "FormDesign lays out magazines, newsletters, books, reports, print pieces, ads, web pages and slides: drop in Markdown, PDFs, Word files, images and a brief, pick one of 71 templates, and edit the result with professional page-layout tools. Agents drive it over MCP.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formdesign-engine", "binaries/formdesign-core"],
    "resources": { "../LICENSE": "LICENSE", "../NOTICE.md": "NOTICE.md" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["fdes"], "name": "FormDesign Document", "description": "FormDesign layout document", "role": "Editor", "mimeType": "application/vnd.formdesign+zip" },
      { "ext": ["idml"], "name": "IDML Markup", "description": "IDML layout package", "role": "Editor", "mimeType": "application/vnd.adobe.indesign-idml-package" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/formcompiler/releases/download/formdesign-updates/latest.json"]
    }
  }
}
