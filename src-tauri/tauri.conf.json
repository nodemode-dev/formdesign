{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormDesign",
  "version": "0.28.0",
  "identifier": "ai.nodemode.formdes",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FormDesign",
        "url": "splash.html",
        "width": 360,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Page layout and publishing",
    "longDescription": "formdes lays out magazines, newsletters, books, reports, print pieces, ads, web pages and slides: drop in Markdown, PDFs, Word files, images and a brief, pick one of 71 templates, and edit the result with InDesign-class tools. Agents drive it over MCP.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formdes-engine", "binaries/formdes-core"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["fdes"], "name": "formdes Document", "description": "formdes layout document", "role": "Editor", "mimeType": "application/vnd.formdes+zip" },
      { "ext": ["idml"], "name": "InDesign Markup", "description": "InDesign Markup Language package", "role": "Editor", "mimeType": "application/vnd.adobe.indesign-idml-package" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/formdesign/releases/latest/download/latest.json"]
    }
  }
}
